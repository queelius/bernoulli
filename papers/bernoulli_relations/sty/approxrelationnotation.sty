\NeedsTeXFormat{LaTeX2e}[1994/06/01]
\ProvidesPackage{approxrelationnotation}[2018/01/01 alex towell's approximate relation notation for his various papers]

\RequirePackage{relationnotation}
\RequirePackage{approxsetnotation}

% \ARelation{R}[<fprate>][<tprate>]
% Both rate slots carry fixed, documented meaning, matching the alex.sty papers'
% [\fprate][\tprate] convention: the SUBSCRIPT is the false-positive rate and the
% SUPERSCRIPT is the true-positive rate. With no optional arguments, the bare
% approximate-relation symbol R^{\pm} (the approximate-set glyph) is used. With one
% optional argument, it is read as the false-positive rate (subscript). The previous
% definition hardcoded \sigma in the superscript and silently discarded the second
% optional argument; that ambiguity is removed here.
\NewDocumentCommand{\ARelation}{moo}{%
    \IfNoValueTF{#3}
    {
        \IfNoValueTF{#2}
            {{\relationstyle{#1}}^{\pm}}
            {\Relation{#1}[#2]}
    }
    {\Relation{#1}[#2][#3]}
}

\endinput