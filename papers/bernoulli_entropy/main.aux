\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Space complexity of positive approximate sets as a function of the false positive rate $\varepsilon $. The solid curve is the information-theoretic lower bound $-\log _2 \varepsilon $ bits per element (\cref  {pst:approx_l_b}). The dashed curve is the Bloom filter cost $-(1/\ln 2)\log _2 \varepsilon $; the gap reflects the Bloom filter's $\ln 2 \approx 69\%$ efficiency.}}{6}{figure.caption.34}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:space_lower_bound}{{1}{6}{Space complexity of positive approximate sets as a function of the false positive rate $\fprate $. The solid curve is the information-theoretic lower bound $-\log _2 \fprate $ bits per element (\cref {pst:approx_l_b}). The dashed curve is the Bloom filter cost $-(1/\ln 2)\log _2 \fprate $; the gap reflects the Bloom filter's $\ln 2 \approx 69\%$ efficiency}{figure.caption.34}{}}
\newlabel{fig:space_lower_bound@cref}{{[figure][1][]1}{[1][6][]6}}
